# OpenClaw sidecar -> Python Support Copilot endpoint.
# Keep this file secret-free. Copy values into the actual sidecar environment.

SUPPORT_COPILOT_URL=http://127.0.0.1:8000/channels/openclaw-feishu/support-case

# Must match OPENCLAW_FEISHU_BRIDGE_SECRET in the Python service .env when set.
# Leave empty only for local development on a trusted loopback interface.
OPENCLAW_FEISHU_BRIDGE_SECRET=change-me

# Pinned runtime versions. These mirror package.json/package-lock.json.
OPENCLAW_VERSION=2026.6.6
OPENCLAW_LARK_PLUGIN_VERSION=2026.6.10

# Feishu/Lark credentials belong to the OpenClaw Lark plugin configuration,
# not to the Python support runtime, once the sidecar is the primary channel.
FEISHU_APP_ID=cli_xxx
FEISHU_APP_SECRET=replace-in-secret-store
FEISHU_ENCRYPT_KEY=replace-in-secret-store
FEISHU_VERIFICATION_TOKEN=replace-in-secret-store
